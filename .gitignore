# ALZ Agent - Git Ignore

# VS Code session data
.vscode/alz-agent-session.json
.vscode/*.log

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
out/
*.vsix

# Terraform state files
infrastructure/terraform/.terraform/
infrastructure/terraform/terraform.tfstate
infrastructure/terraform/terraform.tfstate.backup
infrastructure/terraform/.terraform.lock.hcl
*.tfvars.local

# Bicep local parameter files
infrastructure/bicep/*.parameters.local.json
infrastructure/bicep/*.local.bicepparam

# Environment files
.env
.env.local
*.local.json

# Azure credentials (should never be committed)
*.publishsettings
*.azureprofile

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE specific
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Documentation build outputs
docs/_build/
